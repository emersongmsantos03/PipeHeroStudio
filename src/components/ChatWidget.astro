---
/**
 * Chat de IA (worker/chat.ts → /api/chat). Liga/desliga em config.chatEnabled.
 * O botão é leve; o código do chat (src/scripts/chat.ts) só carrega ao abrir.
 */
import { config } from '../config';
import { href, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const S = {
  pt: {
    launch: 'Fale com a Ava', title: 'Ava', sub: 'Assistente virtual · Pipe Hero Studio',
    greeting: 'Olá! Sou a Ava, a assistente virtual da Pipe Hero Studio. Posso tirar dúvidas sobre sites, chat, CRM e agentes de IA, ou ajudar a perceber por onde começar. Em que posso ajudar?',
    chips: ['Quero um site para o meu negócio', 'Quanto custa?', 'Como funciona o "só paga se gostar"?', 'Quero falar com o Emerson'],
    ph: 'Escreva a sua mensagem…', send: 'Enviar', close: 'Fechar o chat', reset: 'Nova conversa',
    note: 'A Ava é uma assistente virtual com IA e pode cometer erros.', privacy: 'Privacidade',
    err: 'Não consegui responder agora. Tente de novo ou escreva para {email}.',
    rate: 'Muitas mensagens seguidas. Espere um minuto e tente de novo.',
    long: 'A conversa ficou longa. Para continuar, escreva para {email} ou comece uma nova conversa.',
    sent: 'Resumo enviado ao Emerson', teaser: 'Olá, sou a Ava! Tem dúvidas? Respondo na hora.', dismiss: 'Fechar',
  },
  en: {
    launch: 'Chat with Ava', title: 'Ava', sub: 'Virtual assistant · Pipe Hero Studio',
    greeting: "Hi! I'm Ava, Pipe Hero Studio's virtual assistant. I can answer questions about websites, chat, CRM and AI agents, or help you figure out where to start. How can I help?",
    chips: ['I need a website for my business', 'How much does it cost?', 'How does "pay only if you like it" work?', 'I want to talk to Emerson'],
    ph: 'Type your message…', send: 'Send', close: 'Close chat', reset: 'New conversation',
    note: 'Ava is an AI virtual assistant and can make mistakes.', privacy: 'Privacy',
    err: "I couldn't reply right now. Please try again or email {email}.",
    rate: 'Too many messages in a row. Please wait a minute and try again.',
    long: 'This conversation got long. To continue, email {email} or start a new conversation.',
    sent: 'Summary sent to Emerson', teaser: "Hi, I'm Ava! Questions? I reply instantly.", dismiss: 'Dismiss',
  },
  es: {
    launch: 'Habla con Ava', title: 'Ava', sub: 'Asistente virtual · Pipe Hero Studio',
    greeting: '¡Hola! Soy Ava, la asistente virtual de Pipe Hero Studio. Puedo resolver dudas sobre webs, chat, CRM y agentes de IA, o ayudarte a ver por dónde empezar. ¿En qué te ayudo?',
    chips: ['Quiero una web para mi negocio', '¿Cuánto cuesta?', '¿Cómo funciona el "solo pagas si te gusta"?', 'Quiero hablar con Emerson'],
    ph: 'Escribe tu mensaje…', send: 'Enviar', close: 'Cerrar el chat', reset: 'Nueva conversación',
    note: 'Ava es una asistente virtual con IA y puede equivocarse.', privacy: 'Privacidad',
    err: 'No he podido responder ahora. Inténtalo de nuevo o escribe a {email}.',
    rate: 'Demasiados mensajes seguidos. Espera un minuto y vuelve a intentarlo.',
    long: 'La conversación se ha alargado. Para seguir, escribe a {email} o empieza una nueva conversación.',
    sent: 'Resumen enviado a Emerson', teaser: '¡Hola, soy Ava! ¿Dudas? Respondo al momento.', dismiss: 'Cerrar',
  },
}[lang];
const data = { ...S, email: config.email, lang };
---
<div class="cb" data-chat data-i18n={JSON.stringify(data)}>
  <p class="cb-teaser" data-chat-teaser hidden>
    <span>{S.teaser}</span>
    <button type="button" class="cb-teaser-x" data-chat-teaser-x aria-label={S.dismiss}>×</button>
  </p>

  <button type="button" class="cb-launch" data-chat-launch aria-expanded="false" aria-controls="cb-panel">
    <span class="cb-launch-ico" aria-hidden="true">
      <img class="i-chat" src="/ava.svg" alt="" width="42" height="42" decoding="async" />
      <svg class="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
    </span>
    <span class="cb-launch-txt">{S.launch}</span>
    <span class="cb-online" aria-hidden="true"></span>
  </button>

  <section class="cb-panel" id="cb-panel" role="dialog" aria-modal="false" aria-labelledby="cb-title" hidden data-chat-panel>
    <header class="cb-head">
      <span class="cb-av">
        <img src="/ava.svg" alt="" width="44" height="44" decoding="async" />
        <i aria-hidden="true"></i>
      </span>
      <span class="cb-id">
        <b id="cb-title">{S.title}</b>
        <small>{S.sub}</small>
      </span>
      <button type="button" class="cb-icon" data-chat-reset aria-label={S.reset} title={S.reset}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="cb-icon" data-chat-close aria-label={S.close} title={S.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </button>
    </header>

    <div class="cb-log" role="log" aria-live="polite" aria-relevant="additions" data-chat-log></div>

    <form class="cb-form" data-chat-form>
      <label class="sr-only" for="cb-input">{S.ph}</label>
      <textarea id="cb-input" rows="1" maxlength="1000" placeholder={S.ph} autocomplete="off" data-chat-input></textarea>
      <button type="submit" class="cb-send" aria-label={S.send} data-chat-send>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </form>
    <p class="cb-note">{S.note} <a href={href(lang, 'privacy')}>{S.privacy}</a></p>
  </section>
</div>

<script>
  // Carrega o chat só quando é preciso (clique, passagem do rato, ou conversa aberta noutra página).
  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const launch = root.querySelector<HTMLButtonElement>('[data-chat-launch]')!;
    let mod: Promise<typeof import('../scripts/chat')> | null = null;
    const load = () => (mod ||= import('../scripts/chat').then((m) => (m.init(root), m)));
    launch.addEventListener('click', () => load().then((m) => m.toggle()));
    launch.addEventListener('pointerenter', () => load(), { once: true });
    launch.addEventListener('focus', () => load(), { once: true });
    let wasOpen = false;
    try { wasOpen = sessionStorage.getItem('phs-chat-open') === '1'; } catch { /* sem armazenamento */ }
    if (wasOpen) load().then((m) => m.open(false));

    // Convite discreto, uma vez por sessão, só em ecrãs grandes.
    const teaser = root.querySelector<HTMLElement>('[data-chat-teaser]')!;
    let seen = false;
    try { seen = sessionStorage.getItem('phs-chat-teaser') === '1'; } catch { /* sem armazenamento */ }
    if (!seen && !wasOpen && matchMedia('(min-width: 900px)').matches) {
      setTimeout(() => {
        if (root.querySelector('[data-chat-panel]')!.hasAttribute('hidden')) teaser.hidden = false;
        try { sessionStorage.setItem('phs-chat-teaser', '1'); } catch { /* sem armazenamento */ }
      }, 12000);
    }
    const hideTeaser = () => { teaser.hidden = true; };
    root.querySelector('[data-chat-teaser-x]')!.addEventListener('click', hideTeaser);
    teaser.querySelector('span')!.addEventListener('click', () => { hideTeaser(); launch.click(); });
    launch.addEventListener('click', hideTeaser);
  }
</script>

<style is:global>
  .cb { position: fixed; right: 20px; bottom: 20px; z-index: 70; display: grid; justify-items: end; gap: 12px; }
  .cb-launch {
    position: relative; display: inline-flex; align-items: center; gap: 10px;
    height: 56px; padding: 0 22px 0 8px; border-radius: 999px; cursor: pointer;
    background: var(--ink); color: var(--bg); border: 0; font: inherit; font-weight: 500; font-size: 0.98rem;
    box-shadow: 0 14px 34px -12px rgb(16 24 43 / 0.55), 0 0 0 1px rgb(255 255 255 / 0.06) inset;
    transition: transform 0.2s var(--ease);
  }
  .cb-launch:hover { transform: translateY(-2px); }
  .cb-launch-ico { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--hero); color: var(--on-hero); }
  .cb-launch-ico svg { width: 22px; height: 22px; }
  .cb-launch-ico img { width: 42px; height: 42px; border-radius: 50%; display: block; }
  .cb-launch .i-close { display: none; }
  .cb-launch[aria-expanded='true'] .i-chat { display: none; }
  .cb-launch[aria-expanded='true'] .i-close { display: block; }
  .cb-online { position: absolute; left: 39px; top: 9px; width: 11px; height: 11px; border-radius: 50%; background: #22c55e; border: 2px solid var(--ink); }
  .cb-launch[aria-expanded='true'] .cb-online { display: none; }

  .cb-teaser {
    display: flex; align-items: center; gap: 8px; max-width: 280px; margin: 0;
    padding: 12px 10px 12px 16px; border-radius: 16px 16px 4px 16px;
    background: var(--surface); border: 1px solid var(--line); color: var(--ink); font-size: 0.92rem;
    box-shadow: 0 18px 40px -20px rgb(16 24 43 / 0.45); cursor: pointer;
  }
  @media (prefers-reduced-motion: no-preference) { .cb-teaser:not([hidden]) { animation: cb-up 0.35s var(--ease) both; } }
  .cb-teaser-x { width: 28px; height: 28px; flex: none; border: 0; border-radius: 8px; background: none; color: var(--muted); font-size: 1.2rem; cursor: pointer; }
  .cb-teaser-x:hover { background: var(--surface-2); color: var(--ink); }

  .cb-panel {
    position: fixed; right: 20px; bottom: 88px;
    width: min(400px, calc(100vw - 40px)); height: min(640px, calc(100dvh - 120px));
    display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto;
    background: var(--surface); border: 1px solid var(--line); border-radius: 22px; overflow: hidden;
    box-shadow: 0 40px 90px -30px rgb(16 24 43 / 0.55), 0 8px 24px -12px rgb(16 24 43 / 0.25);
    transform-origin: bottom right;
  }
  @media (prefers-reduced-motion: no-preference) { .cb-panel:not([hidden]) { animation: cb-open 0.24s var(--ease) both; } }
  @keyframes cb-open { from { transform: translateY(12px) scale(0.97); } }
  @keyframes cb-up { from { transform: translateY(8px); } }

  .cb-head { display: flex; align-items: center; gap: 10px; padding: 14px 10px 14px 16px; background: var(--ink); color: var(--bg); }
  .cb-av { position: relative; width: 44px; height: 44px; flex: none; }
  .cb-av img { width: 44px; height: 44px; border-radius: 50%; display: block; box-shadow: 0 0 0 2px rgb(255 255 255 / 0.18); }
  .cb-av i { position: absolute; right: 0; bottom: 1px; width: 11px; height: 11px; border-radius: 50%; background: #22c55e; border: 2px solid var(--ink); }
  .cb-id { display: grid; line-height: 1.3; margin-right: auto; min-width: 0; }
  .cb-id b { font-weight: 500; }
  .cb-id small { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; opacity: 0.8; }
  .cb-id small i { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; flex: none; }
  .cb-icon { width: 40px; height: 40px; flex: none; border: 0; border-radius: 10px; background: none; color: inherit; display: grid; place-items: center; cursor: pointer; opacity: 0.85; }
  .cb-icon:hover { opacity: 1; background: rgb(255 255 255 / 0.1); }
  .cb-icon svg { width: 20px; height: 20px; }
  .cb-head :focus-visible { outline-color: var(--hero); }

  .cb-log { overflow-y: auto; overscroll-behavior: contain; padding: 18px 14px 8px; display: flex; flex-direction: column; gap: 10px; background: var(--surface-2); scroll-behavior: smooth; }
  .cb-msg { max-width: 86%; padding: 10px 14px; border-radius: 18px; font-size: 0.95rem; line-height: 1.5; overflow-wrap: anywhere; }
  .cb-msg p { margin: 0; }
  .cb-msg p + p, .cb-msg p + ul, .cb-msg ul + p { margin-top: 8px; }
  .cb-msg ul { margin: 0; padding-left: 1.15em; display: grid; gap: 3px; }
  .cb-msg strong { font-weight: 600; }
  .cb-msg a { color: inherit; text-decoration: underline; text-underline-offset: 0.18em; }
  .cb-msg.is-ai { align-self: flex-start; background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 6px; }
  .cb-msg.is-me { align-self: flex-end; background: var(--ink); color: var(--bg); border-bottom-right-radius: 6px; white-space: pre-wrap; }
  .cb-msg.is-err { align-self: flex-start; background: color-mix(in srgb, var(--danger) 10%, var(--surface)); border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent); }
  @media (prefers-reduced-motion: no-preference) { .cb-msg.is-new { animation: cb-up 0.25s var(--ease) both; } }
  .cb-typing { display: inline-flex; gap: 4px; padding: 4px 0; }
  .cb-typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    .cb-typing i { animation: cb-dot 1s ease-in-out infinite; }
    .cb-typing i:nth-child(2) { animation-delay: 0.15s; }
    .cb-typing i:nth-child(3) { animation-delay: 0.3s; }
  }
  @keyframes cb-dot { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-4px); } }
  .cb-sys { align-self: center; display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.04em; background: color-mix(in srgb, var(--hero) 30%, var(--surface)); color: var(--ink); }
  .cb-chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 2px 0 6px; }
  .cb-chip { padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); font: inherit; font-size: 0.86rem; cursor: pointer; text-align: left; transition: border-color 0.2s, background-color 0.2s; }
  .cb-chip:hover { border-color: var(--ink); background: color-mix(in srgb, var(--hero) 18%, var(--surface)); }

  .cb-form { display: flex; align-items: flex-end; gap: 8px; padding: 12px 12px 8px; border-top: 1px solid var(--line); background: var(--surface); }
  .cb-form textarea {
    flex: 1; min-width: 0; resize: none; max-height: 120px; min-height: 44px; padding: 11px 14px; line-height: 1.4;
    border: 1.5px solid var(--line-strong); border-radius: 14px; background: var(--bg); color: var(--ink); font: inherit; font-size: 0.95rem;
  }
  .cb-form textarea:focus-visible { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px color-mix(in srgb, var(--hero) 60%, transparent); }
  .cb-send { width: 44px; height: 44px; flex: none; border: 0; border-radius: 14px; background: var(--hero); color: var(--on-hero); display: grid; place-items: center; cursor: pointer; transition: transform 0.15s; }
  .cb-send:hover { transform: translateY(-1px); }
  .cb-send[disabled] { opacity: 0.5; cursor: progress; transform: none; }
  .cb-send svg { width: 20px; height: 20px; }
  .cb-note { margin: 0; padding: 0 14px 12px; background: var(--surface); font-size: 0.74rem; color: var(--muted); }
  .cb-note a { color: inherit; }

  @media (max-width: 599px) {
    .cb { right: 14px; bottom: 14px; }
    .cb-launch { padding: 0 7px; height: 56px; }
    .cb-launch-txt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cb-panel {
      inset: 0; width: auto; height: 100dvh; border-radius: 0; border: 0;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .cb-head { padding-top: calc(14px + env(safe-area-inset-top)); }
    .cb:has(.cb-panel:not([hidden])) .cb-launch { display: none; }
    .cb-form textarea { font-size: 16px; } /* evita zoom no iPhone */
  }
</style>
