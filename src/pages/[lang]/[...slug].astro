---
import { ROUTES, type Lang, type PageKey } from '../../i18n/routes';
import Home from '../../views/Detailing.astro';
import Demo from '../../views/DetailingDemo.astro';
import Sites from '../../views/Sites.astro';
import Clinics from '../../views/Clinics.astro';
import Crm from '../../views/Crm.astro';
import Agents from '../../views/Agents.astro';
import Contact from '../../views/Contact.astro';
import Book from '../../views/Book.astro';
import Legal from '../../views/Legal.astro';
import NotFound from '../../views/NotFound.astro';

export function getStaticPaths() {
  return (['en'] as const).flatMap((lang) =>
    (Object.keys(ROUTES) as PageKey[]).map((key) => ({
      params: { lang, slug: ROUTES[key][lang] || undefined },
      props: { lang, key },
    })),
  );
}

const { lang, key } = Astro.props as { lang: Lang; key: PageKey };
---
{key === 'home' && <Home />}
{key === 'demo' && <Demo />}
{key === 'sites' && <Sites lang={lang} />}
{key === 'clinics' && <Clinics lang={lang} />}
{key === 'crm' && <Crm lang={lang} />}
{key === 'agents' && <Agents lang={lang} />}
{key === 'contact' && <Contact lang={lang} />}
{key === 'book' && <Book lang={lang} />}
{(key === 'privacy' || key === 'terms' || key === 'cookies') && <Legal lang={lang} page={key} />}
{key === 'notFound' && <NotFound lang={lang} />}
