---
import Logo from './Logo.astro';
import { t } from '../i18n';
import { href, type Lang, type PageKey } from '../i18n/routes';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const d = t(lang);
const nav: { label: string; url: string; cta?: boolean }[] = [
  { label: 'Live demo', url: '/en/demo/' },
  { label: 'How it works', url: '/en/#how-it-works' },
  { label: 'Pricing', url: '/en/#plans' },
  { label: 'Book a call', url: '/en/book/', cta: true },
];
---
<header class="site-header">
  <div class="wrap header-in">
    <a class="brand" href={href(lang, 'home')} aria-label={d.ui.homeLabel}>
      <Logo />
      <span class="brand-name">Pipe Hero Studio</span>
    </a>

    <nav class="nav-main" aria-label={d.ui.navLabel}>
      <ul>
        {nav.map((n) => (
          <li><a href={n.url} data-campaign-link class={n.cta ? 'nav-cta' : undefined} aria-current={href(lang, page) === n.url ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <details class="hdr-pop menu" data-pop>
      <summary><span class="burger" aria-hidden="true"><i></i><i></i></span>{d.ui.menu}</summary>
      <nav class="pop-panel menu-panel" aria-label={d.ui.navLabel}>
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.url} data-campaign-link aria-current={href(lang, page) === n.url ? 'page' : undefined}>
                {n.label}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  // Menus do cabeçalho: só um aberto, fecham ao tocar fora ou com Esc.
  (function () {
    var pops = document.querySelectorAll('[data-pop]');
    pops.forEach(function (p) {
      p.addEventListener('toggle', function () {
        if (p.open) pops.forEach(function (o) { if (o !== p) o.open = false; });
      });
    });
    document.addEventListener('click', function (e) {
      pops.forEach(function (p) { if (p.open && !p.contains(e.target)) p.open = false; });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      pops.forEach(function (p) { if (p.open) { p.open = false; p.querySelector('summary').focus(); } });
    });
  })();
</script>
