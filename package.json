{
  "name": "pipeherostudio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:links": "node scripts/check-links.mjs",
    "types": "wrangler types && wrangler types -c admin/wrangler.jsonc admin/worker-configuration.d.ts",
    "dev:admin": "wrangler dev -c admin/wrangler.jsonc --port 8788",
    "deploy:admin": "wrangler deploy -c admin/wrangler.jsonc",
    "deploy:all": "npm run deploy && npm run deploy:admin",
    "db:migrate": "wrangler d1 migrations apply pipehero-crm --remote"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.4.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
