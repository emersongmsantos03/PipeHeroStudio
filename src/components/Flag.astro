---
/** Bandeiras simplificadas em SVG (3:2). Decorativas: o nome do idioma vai sempre em texto. */
interface Props { code: 'us' | 'gb' | 'br' | 'pt' | 'es' }
const { code } = Astro.props;
const stripes = [1, 3, 5, 7, 9, 11].map((i) => i * (20 / 13));
---
<span class="flag" aria-hidden="true">
  {code === 'us' && (
    <svg viewBox="0 0 30 20">
      <rect width="30" height="20" fill="#B22234" />
      {stripes.map((y) => <rect y={y} width="30" height={20 / 13} fill="#fff" />)}
      <rect width="13" height={20 / 13 * 7} fill="#3C3B6E" />
      {[2, 5, 8, 11].map((x) => [2.2, 5.4, 8.6].map((y) => <circle cx={x + 0.2} cy={y} r="0.75" fill="#fff" />))}
    </svg>
  )}
  {code === 'gb' && (
    <svg viewBox="0 0 30 20">
      <rect width="30" height="20" fill="#012169" />
      <path d="M0 0L30 20M30 0L0 20" stroke="#fff" stroke-width="4" />
      <path d="M0 0L30 20M30 0L0 20" stroke="#C8102E" stroke-width="1.4" />
      <path d="M15 0V20M0 10H30" stroke="#fff" stroke-width="6" />
      <path d="M15 0V20M0 10H30" stroke="#C8102E" stroke-width="3.2" />
    </svg>
  )}
  {code === 'br' && (
    <svg viewBox="0 0 30 20">
      <rect width="30" height="20" fill="#009C3B" />
      <path d="M15 2.4L27.6 10L15 17.6L2.4 10Z" fill="#FFDF00" />
      <circle cx="15" cy="10" r="4.7" fill="#002776" />
      <path d="M10.6 9.1q4.6-1.3 8.9 1.4" stroke="#fff" stroke-width="0.9" fill="none" />
    </svg>
  )}
  {code === 'pt' && (
    <svg viewBox="0 0 30 20">
      <rect width="30" height="20" fill="#FF0000" />
      <rect width="12" height="20" fill="#006600" />
      <circle cx="12" cy="10" r="4.4" fill="#FFCC00" />
      <circle cx="12" cy="10" r="3.1" fill="#FF0000" />
      <rect x="10.6" y="8.4" width="2.8" height="3.4" rx="0.6" fill="#fff" />
    </svg>
  )}
  {code === 'es' && (
    <svg viewBox="0 0 30 20">
      <rect width="30" height="20" fill="#AA151B" />
      <rect y="5" width="30" height="10" fill="#F1BF00" />
      <rect x="7" y="7.6" width="3.4" height="4.8" rx="0.8" fill="#AA151B" opacity="0.85" />
    </svg>
  )}
</span>
