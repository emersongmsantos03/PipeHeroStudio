---
import Base from '../layouts/Base.astro';
import Station from '../components/Station.astro';
import Elbow from '../components/Elbow.astro';
import ContactForm from '../components/ContactForm.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Arrow from '../components/Arrow.astro';
import { t } from '../i18n';
import { href, priceFrom, type Lang } from '../i18n/routes';
import { config } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const a = d.agents;
const agentsPrice = priceFrom(lang, config.agentsFrom, d.ui.onRequest, d.ui.from);
const schema = [{ '@type': 'Service', name: a.price.label, description: a.description, serviceType: 'AI agents' }];
---
<Base lang={lang} page="agents" title={a.title} description={a.description} schema={schema}>
  <section class="lhero wrap" aria-labelledby="ag-title">
    <div class="lhero-text">
      <p class="tag"><b>02</b><span aria-hidden="true">/</span>Chat<span aria-hidden="true">·</span><b>04</b><span aria-hidden="true">/</span>{d.home.stations[3].name}</p>
      <h1 id="ag-title">{a.hero.title}</h1>
      <p class="lead">{a.hero.lead}</p>
      <div class="lhero-cta"><a class="btn btn-hero" href="#pedido">{a.hero.cta}<Arrow /></a></div>
    </div>

    <figure class="demo panel" data-typer>
      <div class="demo-head">
        <span class="demo-av" aria-hidden="true">IA</span>
        <span class="demo-id"><b>{a.demo.business}</b><small><i aria-hidden="true"></i>{a.demo.status}</small></span>
        <span class="tag-example">{d.ui.example}</span>
      </div>
      <ol class="demo-log">
        {a.demo.messages.map(([who, text]) => (
          <li class={`dm is-${who}`}><span class="sr-only">{who === 'ai' ? a.demo.ai : a.demo.you}: </span><span class="dm-t">{text}</span></li>
        ))}
      </ol>
      <figcaption class="demo-cap muted">{a.demo.caption}</figcaption>
    </figure>
  </section>

  <div class="line wrap">
    <Station side="left" code="02" name={a.chat.name} labelledby="ag-chat" id="chat" start>
      <div class="st-grid">
        <div class="st-text">
          <h2 id="ag-chat">{a.chat.title}</h2>
          <p class="lead">{a.chat.text}</p>
        </div>
        <div class="widget panel" aria-hidden="true">
          <div class="w-site"><i></i><i></i><i></i></div>
          <div class="w-bubble">
            <span class="tag"><b>IA</b>{a.demo.status}</span>
            <ul class="ticks">{a.chat.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
        <ul class="ticks sr-only">{a.chat.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="04" name={a.does.name} labelledby="ag-does">
      <div class="station-head"><h2 id="ag-does">{a.does.title}</h2></div>
      <ol class="items">
        {a.does.items.map(([h, p], i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="04.1" name={a.rules.name} labelledby="ag-rules">
      <div class="station-head"><h2 id="ag-rules">{a.rules.title}</h2></div>
      <ul class="items">
        {a.rules.items.map(([h, p], i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ul>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="04.2" name={a.price.name} labelledby="ag-price">
      <div class="st-grid">
        <div class="st-text">
          <h2 id="ag-price">{a.price.title}</h2>
          <p class="lead">{a.price.note}</p>
        </div>
        <div class="price-stack">
          <div class="price-card panel">
            <p class="tag">{a.price.label}</p>
            <p class:list={['price-amount', !config.agentsFrom && 'is-text']}>{agentsPrice}</p>
          </div>
          <a class="vertical panel" href={href(lang, 'clinics')}>
            <span class="tag"><b>04</b>{d.ui.nav.clinics}</span>
            <span class="v-title">{a.vertical.title}</span>
            <span class="muted">{a.vertical.text}</span>
            <span class="link link-arrow">{a.vertical.link}<Arrow /></span>
          </a>
        </div>
      </div>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="04.3" name={a.form.name} labelledby="ag-form" end>
      <div class="form-split">
        <div class="st-text">
          <h2 id="ag-form">{a.form.title}</h2>
          <p class="lead">{a.form.text}</p>
          <CopyEmail lang={lang} label={d.form.emailAlt} />
        </div>
        <ContactForm lang={lang} page="agents" service="agents" />
      </div>
    </Station>
  </div>
</Base>

<script>
  import '../scripts/typer';
</script>

<style>
  .demo { padding: 0; display: grid; width: 100%; max-width: 440px; justify-self: end; overflow: hidden; }
  .demo-head { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .demo-av { width: 38px; height: 38px; border-radius: 11px; background: var(--hero); color: var(--on-hero); display: grid; place-items: center; font-family: var(--f-mono); font-weight: 500; font-size: 0.8rem; flex: none; }
  .demo-id { display: grid; line-height: 1.3; margin-right: auto; }
  .demo-id small { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 0.82rem; }
  .demo-id small i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
  .demo-log { list-style: none; margin: 0; padding: 18px 16px; display: grid; gap: 10px; background: var(--surface-2); }
  .dm { position: relative; max-width: 86%; padding: 10px 13px; border-radius: 14px; font-size: 0.95rem; }
  .dm.is-user { justify-self: end; background: var(--ink); color: var(--bg); border-bottom-right-radius: 4px; }
  .dm.is-ai { background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
  .dm.is-pending { visibility: hidden; }
  .dm.is-typing { visibility: visible; }
  .dm.is-typing > * { visibility: hidden; }
  .dm.is-typing::after {
    content: ''; position: absolute; left: 14px; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%;
    background: var(--muted); box-shadow: 11px 0 0 var(--muted), 22px 0 0 var(--muted);
    animation: dm-dots 1s steps(2, jump-none) infinite;
  }
  .dm.is-shown { animation: dm-in 0.35s var(--ease) both; }
  @keyframes dm-in { from { opacity: 0; transform: translateY(6px); } }
  @keyframes dm-dots { 50% { opacity: 0.35; } }
  .demo-cap { padding: 12px 16px; font-size: 0.85rem; border-top: 1px solid var(--line); }
  @media (max-width: 899px) { .demo { justify-self: stretch; max-width: none; } }

  .widget { position: relative; min-height: 300px; padding: 18px; overflow: hidden; }
  .w-site { display: grid; gap: 10px; }
  .w-site i { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); }
  .w-site i:nth-child(1) { width: 40%; height: 18px; }
  .w-site i:nth-child(2) { width: 80%; }
  .w-site i:nth-child(3) { width: 65%; }
  .w-bubble {
    position: absolute; right: 18px; bottom: 18px; left: 18%; padding: 16px; display: grid; gap: 12px;
    background: var(--bg); border: 1.5px solid var(--ink); border-radius: 14px 14px 4px 14px;
  }
  .price-stack { display: grid; gap: 16px; }
  .vertical { display: grid; gap: 10px; padding: 22px; text-decoration: none; max-width: 560px; transition: border-color 0.2s; }
  .vertical:hover { border-color: var(--ink); }
  .v-title { font-family: var(--f-display); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.02em; }
</style>
