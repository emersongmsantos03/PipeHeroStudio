---
import Base from '../layouts/Base.astro';
import Station from '../components/Station.astro';
import Elbow from '../components/Elbow.astro';
import PhoneMock from '../components/PhoneMock.astro';
import MiniSite from '../components/MiniSite.astro';
import ContactForm from '../components/ContactForm.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Faq from '../components/Faq.astro';
import Arrow from '../components/Arrow.astro';
import { t, fill } from '../i18n';
import { href, price, CURRENCY, type Lang } from '../i18n/routes';
import type { BizType } from '../lib/minisite';
import { config } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const s = d.sites;
const sitePrice = price(lang, config.sitePrice, d.ui.onRequest);
const maintenance = price(lang, config.maintenanceFrom, d.ui.onRequest);
const examples = d.minisite.siteExamples;
const faq = s.faq.items.map(([q, a]) => [q, fill(a, { maintenance })]);
const schema = [
  {
    '@type': 'Service',
    name: s.price.label,
    description: s.description,
    serviceType: 'Web design',
    areaServed: 'Worldwide',
    ...(config.sitePrice
      ? { offers: { '@type': 'Offer', price: String(config.sitePrice[CURRENCY[lang]]), priceCurrency: CURRENCY[lang] } }
      : {}),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base lang={lang} page="sites" title={s.title} description={s.description} schema={schema}>
  <section class="lhero wrap sites-hero" aria-labelledby="sites-title">
    <div class="lhero-text">
      <p class="tag"><b>01</b><span aria-hidden="true">/</span>{d.home.stations[0].name}</p>
      <h1 id="sites-title">{s.hero.title}</h1>
      <p class="h3-strong"><span class="hl">{s.hero.strong}</span></p>
      <p class="lead">{s.hero.lead}</p>
      <div class="lhero-cta">
        <a class="btn btn-hero" href="#pedido">{s.hero.cta}<Arrow /></a>
        <p class="price-chip"><b>{sitePrice}</b> <span>{s.hero.priceNote}</span></p>
      </div>
    </div>

    <figure class="lhero-visual ex">
      <fieldset class="ex-tabs">
        <legend class="sr-only">{s.examples.legend}</legend>
        {examples.map((e, i) => (
          <>
            <input class="sr-only" type="radio" name="ex" id={`ex-${i}`} checked={i === 0} />
            <label for={`ex-${i}`}>{d.minisite.types[e.type as BizType].label}</label>
          </>
        ))}
      </fieldset>
      <PhoneMock size="lg">
        <div class="ex-stack">
          {examples.map((e, i) => (
            <div class="ex-slide" data-i={i}><MiniSite lang={lang} name={e.name} type={e.type as BizType} /></div>
          ))}
        </div>
      </PhoneMock>
      <figcaption class="ex-cap"><span class="tag-example">{d.ui.example}</span> <span class="muted">{s.examples.text}</span></figcaption>
    </figure>
  </section>

  <div class="line wrap">
    <Station side="left" code="01.1" name={s.includes.name} labelledby="s-inc" start>
      <div class="station-head"><h2 id="s-inc">{s.includes.title}</h2></div>
      <ol class="items">
        {s.includes.items.map(([h, p], i) => (
          <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>
        ))}
      </ol>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="01.2" name={s.timeline.name} labelledby="s-time">
      <div class="station-head"><h2 id="s-time">{s.timeline.title}</h2></div>
      <ol class="timeline">
        {s.timeline.steps.map(([h, p], i) => (
          <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>
        ))}
      </ol>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="01.3" name={s.price.name} labelledby="s-price">
      <div class="st-grid">
        <div class="st-text">
          <h2 id="s-price">{s.price.title}</h2>
          <p class="lead">{s.price.note}</p>
          <p><a class="link link-arrow" href={href(lang, 'terms')}>{s.price.terms}<Arrow /></a></p>
        </div>
        <div class="price-card panel">
          <p class="tag">{s.price.label}</p>
          <p class="price-amount">{sitePrice}</p>
          <p class="muted">{s.hero.strong}</p>
          <div class="price-row"><span>{s.price.maintenance}</span><b>{maintenance}</b></div>
        </div>
      </div>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="01.4" name={s.faq.name} labelledby="s-faq">
      <div class="station-head"><h2 id="s-faq">{s.faq.title}</h2></div>
      <div class="faq-wrap"><Faq items={faq} /></div>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="01.5" name={s.form.name} labelledby="s-form" end>
      <div class="form-split">
        <div class="st-text">
          <h2 id="s-form">{s.form.title}</h2>
          <p class="lead">{s.form.text}</p>
          <CopyEmail lang={lang} label={d.form.emailAlt} />
        </div>
        <ContactForm lang={lang} page="sites" service="site" />
      </div>
    </Station>
  </div>
</Base>

<style>
  .h3-strong { font-family: var(--f-display); font-weight: 600; font-size: clamp(1.3rem, 1rem + 1.4vw, 2rem); letter-spacing: -0.02em; line-height: 1.2; }
  .price-chip { display: inline-flex; align-items: baseline; gap: 8px; font-family: var(--f-mono); font-size: 0.9rem; color: var(--muted); }
  .price-chip b { font-family: var(--f-display); font-weight: 800; font-size: 1.5rem; color: var(--ink); letter-spacing: -0.03em; }

  .ex-tabs { border: 0; margin: 0; padding: 4px; display: flex; gap: 4px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  .ex-tabs label { cursor: pointer; padding: 8px 14px; min-height: 40px; display: inline-flex; align-items: center; border-radius: 8px; font-size: 0.92rem; font-weight: 500; color: var(--muted); }
  .ex-tabs label:hover { color: var(--ink); }
  .ex-tabs input:checked + label { background: var(--hero); color: var(--on-hero); }
  .ex-tabs input:focus-visible + label { outline: 3px solid var(--ink); outline-offset: 2px; }
  .ex-stack { height: 100%; }
  .ex-slide { height: 100%; display: none; }
  .ex-slide[data-i='0'] { display: block; }
  .ex:has(#ex-1:checked) .ex-slide[data-i='0'], .ex:has(#ex-2:checked) .ex-slide[data-i='0'] { display: none; }
  .ex:has(#ex-1:checked) .ex-slide[data-i='1'], .ex:has(#ex-2:checked) .ex-slide[data-i='2'] { display: block; }
  .ex-cap { display: flex; gap: 10px; align-items: baseline; max-width: 340px; font-size: 0.9rem; }
  .ex-cap .tag-example { flex: none; }
  @media (max-width: 899px) { .sites-hero :global(.phone-lg) { --phone-w: 300px; } }
  .faq-wrap { max-width: 820px; margin-left: auto; }
  @media (max-width: 899px) { .faq-wrap { margin-left: 0; } }
</style>
