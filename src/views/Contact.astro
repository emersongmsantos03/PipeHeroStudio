---
import Base from '../layouts/Base.astro';
import Station from '../components/Station.astro';
import ContactForm from '../components/ContactForm.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { t } from '../i18n';
import { href, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
---
<Base lang={lang} page="contact" title={c.title} description={c.description}>
  <div class="line wrap">
    <Station side="left" name={d.ui.nav.contact} labelledby="ct-title" start end>
      <div class="form-split">
        <div class="st-text">
          <h1 id="ct-title">Tell us about your detailing shop.</h1>
          <p class="lead">Share what you need and we’ll follow up by email. You can also book a free 15-minute call.</p>
          <CopyEmail lang={lang} label={d.form.email} />
          <dl class="ct-list">
            <div><dt class="tag">{d.book.nav}</dt><dd><a class="link" href={href(lang, 'book')}>{d.hero.book}</a></dd></div>
            <div><dt class="tag">{c.callTitle}</dt><dd class="muted">{c.callText}</dd></div>
          </dl>
        </div>
        <ContactForm lang={lang} page="contact" />
      </div>
    </Station>
  </div>
</Base>

<style>
  h1 { font-size: clamp(2.2rem, 1.4rem + 3.6vw, 4rem); }
  .ct-list { margin: 8px 0 0; display: grid; }
  .ct-list div { display: grid; gap: 6px; padding: 16px 0; border-top: 1px solid var(--line); }
  .ct-list dd { margin: 0; }
</style>
