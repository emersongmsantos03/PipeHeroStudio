---
import Logo from './Logo.astro';
import { t } from '../i18n';
import { href, type Lang } from '../i18n/routes';
import { config } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href={href(lang, 'home')} aria-label={d.ui.homeLabel}><Logo /><span>Pipe Hero Studio</span></a>
        <p class="footer-line">Websites & AI for auto detailers.</p>
      </div>
      <div>
        <h2>{d.ui.footerServices}</h2>
        <ul>
          <li><a class="link" href="/en/demo/" data-campaign-link>Live demo</a></li>
          <li><a class="link" href="/en/#plans">Pricing</a></li>
        </ul>
      </div>
      <div>
        <h2>{d.ui.footerStudio}</h2>
        <ul>
          <li><a class="link" href={href(lang, 'contact')}>{d.ui.nav.contact}</a></li>
          <li><a class="link" href={`mailto:${config.email}`}>{config.email}</a></li>
          <li><a class="link" href={href(lang, 'book')}>{d.ui.nav.book}</a></li>
        </ul>
      </div>
      <div>
        <h2>{d.ui.footerLegal}</h2>
        <ul>
          <li><a class="link" href={href(lang, 'privacy')}>{d.ui.legal.privacy}</a></li>
          <li><a class="link" href={href(lang, 'terms')}>{d.ui.legal.terms}</a></li>
          <li><a class="link" href={href(lang, 'cookies')}>{d.ui.legal.cookies}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>© {year} Pipe Hero Studio</span>
      <span>pipeherostudio.digital</span>
    </div>
  </div>
</footer>
