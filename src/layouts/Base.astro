---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { t } from '../i18n';
import { LOCALE, OG_LOCALE, absolute, href, type Lang, type PageKey } from '../i18n/routes';
import { config } from '../config';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { lang, page, title, description, schema = [], noindex = false } = Astro.props;
const d = t(lang);
const canonical = absolute(href(lang, page));
const ogImage = absolute(`/og/${lang}.png`);
const orgId = `${config.siteUrl}/#org`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: config.brand,
      url: config.siteUrl,
      email: config.email,
      logo: absolute('/apple-touch-icon.png'),
      slogan: 'Websites & AI for auto detailers.',
      founder: { '@type': 'Person', name: config.founder },
    },
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      inLanguage: LOCALE[lang],
      isPartOf: { '@type': 'WebSite', name: config.brand, url: config.siteUrl },
      publisher: { '@id': orgId },
    },
    ...schema.map((s) => ({ provider: { '@id': orgId }, ...s })),
  ],
};
const chatOn = config.chatEnabled && page !== 'demo';
---
<!doctype html>
<html lang={LOCALE[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#eef1f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/unbounded-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pipe Hero Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Websites & AI for auto detailers." />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class:list={[page === 'home' && 'site-home']}>
    <a class="skip" href="#main">{d.ui.skip}</a>
    {page !== 'demo' && <Header lang={lang} page={page} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {page !== 'demo' && <Footer lang={lang} />}
    {chatOn && <ChatWidget lang={lang} />}
    <script>
      import { campaignFromBrowser } from '../scripts/campaign-browser';

      const campaign = campaignFromBrowser();
      if (campaign.utm_source) {
        for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-campaign-link]')) {
          const url = new URL(link.href, location.href);
          if (url.origin !== location.origin) continue;
          for (const [key, value] of Object.entries(campaign)) url.searchParams.set(key, value);
          link.href = url.href;
        }
      }
      function recordSiteActivity(demo?: string) {
        try {
          const qs = new URLSearchParams(location.search);
          const payload = JSON.stringify({ p: location.pathname, r: document.referrer, l: document.documentElement.lang, u: campaign.utm_source || qs.get('ref') || '', ...campaign, demo });
          if (!navigator.sendBeacon?.('/api/pv', payload)) {
            void fetch('/api/pv', { method: 'POST', body: payload, keepalive: true }).catch(() => {});
          }
        } catch { /* analytics is optional */ }
      }
      document.addEventListener('offer-demo-started', (event) => {
        if (event instanceof CustomEvent && typeof event.detail === 'string') recordSiteActivity(event.detail);
      });
      recordSiteActivity();
    </script>
  </body>
</html>
