---
/* 404 geral (fora de /pt/, /en/ e /es/). */
import '../styles/global.css';
import BrokenPipe from '../components/BrokenPipe.astro';
import { href } from '../i18n/routes';
import { t } from '../i18n';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 | Pipe Hero Studio</title>
    <meta name="description" content="This page doesn't exist." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="wrap nf">
      <div class="nf-text">
        <h1 class="tag"><b>404</b><span class="sr-only">Pipe Hero Studio</span></h1>
        {(['en'] as const).map((l) => (
          <div lang="en" class="nf-lang">
            <h2 class="h2">{t(l).notFound.title1}</h2>
            <a class="link link-arrow" href={href(l, 'home')}>{t(l).notFound.home}</a>
          </div>
        ))}
      </div>
      <BrokenPipe />
    </main>
    <style>
      .nf { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 48px; align-items: center; padding-block: 48px; }
      .nf-text { display: grid; gap: 28px; }
      .nf-lang { display: grid; gap: 8px; }
      .nf-lang .h2 { font-size: clamp(1.3rem, 1rem + 1.5vw, 2rem); }
      @media (max-width: 899px) { .nf { grid-template-columns: minmax(0, 1fr); } }
    </style>
  </body>
</html>
