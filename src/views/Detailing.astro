---
import Base from '../layouts/Base.astro';
import '../styles/pipehero-home.css';
const steps = [
  ['Answer and qualify every lead', 'Ava answers service questions day and night and asks the right follow-ups, so each lead arrives with the vehicle, service, photos, name and phone.'],
  ['Book and keep your systems current', 'She offers open times from your booking tool, books, reschedules and cancels, and updates the record in your CRM.'],
  ['Report on your shop, on demand', 'Ask Ava what’s on today’s schedule, which new requests came in or how many jobs of each service you did on a given day or between two dates. She pulls it from your systems and flags what needs your attention.'],
];
---
<Base lang="en" page="home" title="Websites for Auto Detailing Shops | Pipe Hero Studio" description="A fast, mobile-first website that shows off your detailing work and turns visitors into quote requests. Preview in 48 business hours, US$149 launch price, pay only if you love it.">
  <div class="phs-home">
    <section class="wrap phs-hero">
      <div class="phs-hero-copy">
        <p class="phs-eyebrow">Your paint correction deserves better than a blurry Instagram grid</p>
        <h1>Show the swirl-free finish. <em>Book the next one.</em></h1>
        <p class="phs-intro">A site built around your before-and-afters, with your packages and a quote form that asks for the car, so the work sells itself.</p>
        <ul class="phs-proof">
          <li><strong>48h</strong> to see your preview</li>
          <li><strong>US$149</strong> launch price · €139 in Ireland</li>
          <li><strong>$0</strong> unless you love it</li>
        </ul>
        <div class="phs-actions">
          <a class="phs-button" href="/en/contact/?servico=site" data-campaign-link>Get my website preview <span aria-hidden="true">↗</span></a>
          <a class="phs-text-link" href="/en/demo/" data-campaign-link>See a live example <span aria-hidden="true">↗</span></a>
        </div>
        <p class="phs-addon"><span>Add-on</span> Want help with messages and bookings? <a href="#how-it-works">Meet Ava, your AI front desk ↓</a></p>
      </div>
      <a class="phs-demo-image" href="/en/demo/" aria-label="Open the Northline Detailing demo website" data-campaign-link>
        <img src="/images/pipehero-detailing.webp" alt="Graphite sports coupe reflecting warm inspection lights in a detailing garage" width="1200" height="800" fetchpriority="high" />
        <span class="phs-demo-caption">
          <span><small>Example site we built</small><strong>Northline Detailing</strong></span>
          <span class="phs-arrow" aria-hidden="true">↗</span>
        </span>
      </a>
    </section>

    <section class="phs-how" id="how-it-works">
      <div class="wrap phs-how-grid">
        <div>
          <p class="phs-eyebrow">Optional add-on · Ava</p>
          <h2>Then let Ava handle the front desk.</h2>
          <p class="phs-lead">Once your site is live, Ava answers customers, books jobs and keeps your CRM and calendar in order, so you stay on the cars.</p>
          <ol class="phs-steps">
            {steps.map(([title, description], index) => <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </li>)}
          </ol>
          <div class="phs-actions">
            <a class="phs-button" href="/en/demo/#ava" data-campaign-link>Try Ava with a photo <span aria-hidden="true">↗</span></a>
            <a class="phs-text-link" href="/en/demo/#shop-view" data-campaign-link>Try the owner view <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="phs-chat-preview" aria-label="Example conversation with Ava">
          <div class="phs-preview-header"><img src="/images/ava-detailing-v2.webp" alt="" width="40" height="40" /><span><strong>Ava</strong><small>Northline Detailing</small></span></div>
          <div class="phs-preview-log">
            <p class="phs-preview-user">Can I book an interior detail for my CR-V this week?</p>
            <p class="phs-preview-av">Sure! I have tomorrow at 2:00 PM or Friday at 9:00 AM. Which works? I’ll just need your name and phone.</p>
            <div class="phs-preview-photo"><img src="/images/detailing-polish.webp" loading="lazy" alt="" width="90" height="62" /><span><strong>Booked · Tomorrow 2:00 PM</strong><small>Added to the calendar and CRM</small></span></div>
          </div>
          <a href="/en/demo/#ava" data-campaign-link>Open the live chat <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="wrap phs-plans" id="plans">
      <p class="phs-eyebrow">Pricing</p>
      <h2>Start with the site. Add Ava when you need it.</h2>
      <div class="phs-plan-grid">
        <article>
          <h3>Detailing website</h3>
          <p class="phs-launch">Launch price · first 5 shops</p>
          <p class="phs-price">US$149 <small>/ €139 in Ireland · one-time</small></p>
          <p class="phs-regular">Regular price <s>US$199</s> · <s>€189</s></p>
          <p>Most shops start here. Show your services and your best work on a mobile-friendly site with a quote request form. See the preview before you pay.</p>
          <ul class="phs-plan-list">
            <li><strong>Pay only if you love it:</strong> preview in 48 business hours, no payment before you approve.</li>
            <li><strong>Yours from day one:</strong> domain and hosting stay in your name. Use your own, or we set you up on free hosting.</li>
          </ul>
          <a class="phs-button phs-outline" href="/en/contact/?servico=site" data-campaign-link>Request my website <span aria-hidden="true">↗</span></a>
        </article>
        <article>
          <h3>Managed Ava assistant</h3>
          <p class="phs-price">Custom quote <small>/ monthly</small></p>
          <p>Ava connects to the CRM and booking tool you already use and keeps an eye on both.</p>
          <ul class="phs-plan-list">
            <li><strong>For your customers:</strong> answers questions, qualifies leads, books, reschedules and keeps every record current.</li>
            <li><strong>For you:</strong> just ask. “What’s on today?” gets every appointment with times. “How many coatings from the 1st to the 15th?” gets the count by service.</li>
          </ul>
          <p class="phs-plan-note">Monthly pricing depends on the setup and integrations.</p>
          <a class="phs-button" href="/en/contact/?servico=agents" data-campaign-link>Talk to us about Ava <span aria-hidden="true">↗</span></a>
        </article>
      </div>
      <p class="phs-region">Serving detailing shops in the US, Canada and Ireland. Website pricing is in US dollars for the US and Canada and in euros for Ireland. Domain and hosting costs, if any, are paid directly to the provider.</p>
    </section>
  </div>
</Base>
