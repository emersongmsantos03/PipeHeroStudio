---
/**
 * Chat de IA. Só aparece com config.chatEnabled = true e config.chatWebhook preenchido.
 * O webhook (n8n) recebe JSON { sessionId, message, lang, page } e deve responder
 * JSON { reply } (também aceita { output } ou { text }).
 */
import { config } from '../config';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const S = {
  pt: { open: 'Falar com o assistente de IA', close: 'Fechar o chat', title: 'Assistente de IA', hello: 'Olá! Sou o assistente de IA da Pipe Hero Studio. Posso responder a perguntas sobre sites, chat, CRM e agentes de IA. Para falar com uma pessoa, use o formulário de contacto.', ph: 'Escreva a sua pergunta', send: 'Enviar', err: 'Não consegui responder agora. Tente de novo ou use o formulário de contacto.', note: 'Respostas geradas por IA.' },
  en: { open: 'Chat with the AI assistant', close: 'Close chat', title: 'AI assistant', hello: "Hi! I'm Pipe Hero Studio's AI assistant. I can answer questions about websites, chat, CRM and AI agents. To talk to a person, use the contact form.", ph: 'Type your question', send: 'Send', err: "I couldn't reply right now. Please try again or use the contact form.", note: 'Replies are generated by AI.' },
  es: { open: 'Hablar con el asistente de IA', close: 'Cerrar el chat', title: 'Asistente de IA', hello: '¡Hola! Soy el asistente de IA de Pipe Hero Studio. Puedo responder preguntas sobre webs, chat, CRM y agentes de IA. Para hablar con una persona, usa el formulario de contacto.', ph: 'Escribe tu pregunta', send: 'Enviar', err: 'No he podido responder ahora. Inténtalo de nuevo o usa el formulario de contacto.', note: 'Respuestas generadas por IA.' },
}[lang];
---
<div class="chatw" data-chat data-endpoint={config.chatWebhook} data-lang={lang} data-err={S.err}>
  <button type="button" class="chatw-toggle" aria-expanded="false" aria-controls="chatw-panel" data-chat-toggle>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    <span class="sr-only">{S.open}</span>
  </button>
  <section class="chatw-panel panel" id="chatw-panel" aria-label={S.title} hidden data-chat-panel>
    <header class="chatw-head">
      <span class="tag"><b>IA</b>{S.title}</span>
      <button type="button" class="chatw-close" data-chat-close aria-label={S.close}>×</button>
    </header>
    <ol class="chatw-log" aria-live="polite" data-chat-log>
      <li class="chatw-msg is-ai">{S.hello}</li>
    </ol>
    <form class="chatw-form" data-chat-form>
      <label class="sr-only" for="chatw-input">{S.ph}</label>
      <input id="chatw-input" name="message" type="text" autocomplete="off" placeholder={S.ph} maxlength="500" required />
      <button type="submit" class="btn btn-hero">{S.send}</button>
    </form>
    <p class="chatw-note">{S.note}</p>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-chat-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]')!;
    const log = root.querySelector<HTMLOListElement>('[data-chat-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const input = form.querySelector('input')!;
    let sid = '';
    try { sid = sessionStorage.getItem('phs-chat') || ''; } catch { /* sem armazenamento */ }
    if (!sid) {
      sid = Math.random().toString(36).slice(2) + Date.now().toString(36);
      try { sessionStorage.setItem('phs-chat', sid); } catch { /* sem armazenamento */ }
    }
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus(); else toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    root.querySelector('[data-chat-close]')!.addEventListener('click', () => setOpen(false));
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false); });
    const add = (text: string, who: 'ai' | 'me') => {
      const li = document.createElement('li');
      li.className = 'chatw-msg is-' + who;
      li.textContent = text;
      log.appendChild(li);
      log.scrollTop = log.scrollHeight;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message) return;
      add(message, 'me');
      input.value = '';
      try {
        const res = await fetch(root.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: sid, message, lang: root.dataset.lang, page: location.pathname }),
        });
        if (!res.ok) throw new Error();
        const j = await res.json();
        add(String(j.reply ?? j.output ?? j.text ?? root.dataset.err), 'ai');
      } catch {
        add(root.dataset.err || '', 'ai');
      }
    });
  }
</script>

<style>
  .chatw { position: fixed; right: 16px; bottom: 16px; z-index: 60; }
  .chatw-toggle { width: 56px; height: 56px; border-radius: 16px; border: 2px solid var(--ink); background: var(--hero); color: var(--on-hero); display: grid; place-items: center; cursor: pointer; }
  .chatw-toggle svg { width: 24px; height: 24px; }
  .chatw-panel { position: absolute; right: 0; bottom: 68px; width: min(360px, calc(100vw - 32px)); display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto; max-height: min(520px, 75vh); box-shadow: 0 24px 60px -24px rgb(16 24 43 / 0.5); }
  .chatw-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-bottom: 1px solid var(--line); }
  .chatw-close { width: 40px; height: 40px; border: 0; background: none; font-size: 1.5rem; cursor: pointer; border-radius: 8px; }
  .chatw-log { list-style: none; margin: 0; padding: 14px; display: grid; gap: 10px; overflow-y: auto; align-content: start; }
  .chatw-msg { max-width: 85%; padding: 10px 12px; border-radius: 12px; font-size: 0.95rem; }
  .chatw-msg.is-ai { background: var(--surface-2); border-bottom-left-radius: 4px; }
  .chatw-msg.is-me { justify-self: end; background: var(--ink); color: var(--bg); border-bottom-right-radius: 4px; }
  .chatw-form { display: flex; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--line); }
  .chatw-form input { flex: 1; min-width: 0; min-height: 44px; padding: 8px 12px; border: 1.5px solid var(--line-strong); border-radius: 8px; background: var(--bg); }
  .chatw-form .btn { min-height: 44px; padding: 8px 14px; }
  .chatw-note { padding: 0 14px 12px; font-size: 0.8rem; color: var(--muted); }
</style>
