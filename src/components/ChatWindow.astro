---
/**
 * Janela de chat de demonstração (Clínicas e Agentes).
 * As mensagens (<li class="dm is-user|is-ai">) vão no slot e escrevem-se uma vez quando a janela entra no ecrã.
 */
interface Props { title: string; subtitle: string; example: string; caption: string; inputPh: string; class?: string }
const { title, subtitle, example, caption, inputPh, class: cls } = Astro.props;
---
<figure class:list={['cw', cls]} data-typer>
  <div class="cw-head">
    <span class="cw-av" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 3l1.8 4.9L18.7 9.7l-4.9 1.8L12 16.4l-1.8-4.9L5.3 9.7l4.9-1.8z" fill="currentColor" /><path d="M18.5 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" fill="currentColor" /></svg>
    </span>
    <span class="cw-id"><b>{title}</b><small><i aria-hidden="true"></i>{subtitle}</small></span>
    <span class="tag-example">{example}</span>
  </div>
  <ol class="cw-log">
    <slot />
  </ol>
  <div class="cw-input" aria-hidden="true">
    <span>{inputPh}</span>
    <span class="cw-send"><svg viewBox="0 0 24 24"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
  </div>
  <figcaption class="cw-cap">{caption}</figcaption>
</figure>

<script>
  import '../scripts/typer';
</script>

<style is:global>
  .cw {
    position: relative; width: 100%; max-width: 460px; justify-self: end;
    display: grid; overflow: hidden;
    background: var(--surface); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 1px 0 var(--line), 0 40px 80px -48px rgb(16 24 43 / 0.45);
  }
  .cw::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 3px; z-index: 1;
    background: linear-gradient(90deg, var(--hero), color-mix(in srgb, var(--hero) 30%, transparent));
  }
  .cw-head { display: flex; align-items: center; gap: 12px; padding: 16px 18px 14px; border-bottom: 1px solid var(--line); }
  .cw-av { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; flex: none; background: var(--ink); color: var(--hero); }
  .cw-av svg { width: 22px; height: 22px; }
  .cw-id { display: grid; line-height: 1.3; margin-right: auto; min-width: 0; }
  .cw-id b { font-weight: 500; }
  .cw-id small { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 0.82rem; }
  .cw-id small i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent); }
  .cw-log {
    list-style: none; margin: 0; padding: 20px 16px; display: grid; gap: 10px; align-content: start;
    background: var(--surface-2);
  }
  .dm { position: relative; max-width: 86%; padding: 10px 13px; border-radius: 16px; font-size: 0.95rem; line-height: 1.45; }
  .dm.is-user { justify-self: end; background: var(--ink); color: var(--bg); border-bottom-right-radius: 5px; }
  .dm.is-ai { background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 5px; box-shadow: 0 1px 0 var(--line); }
  .dm-rich { max-width: 94%; width: 100%; }
  .dm-t { display: grid; gap: 10px; }
  .dm.is-pending { visibility: hidden; }
  .dm.is-typing { visibility: visible; min-height: 40px; }
  .dm.is-typing > * { visibility: hidden; }
  .dm.is-typing::after {
    content: ''; position: absolute; left: 15px; top: 20px; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%;
    background: var(--muted); box-shadow: 11px 0 0 var(--muted), 22px 0 0 var(--muted);
    animation: dm-dots 1s steps(2, jump-none) infinite;
  }
  .dm.is-shown { animation: dm-in 0.35s var(--ease) both; }
  @keyframes dm-in { from { transform: translateY(8px) scale(0.98); } }
  @keyframes dm-dots { 50% { opacity: 0.35; } }

  .cw-input {
    display: flex; align-items: center; gap: 10px; margin: 0; padding: 12px 14px 12px 18px;
    border-top: 1px solid var(--line); color: var(--muted); font-size: 0.92rem;
  }
  .cw-input span:first-child { flex: 1; }
  .cw-send { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--hero); color: var(--on-hero); }
  .cw-send svg { width: 16px; height: 16px; }
  .cw-cap { padding: 10px 18px 14px; font-size: 0.82rem; color: var(--muted); border-top: 1px dashed var(--line); }
  @media (max-width: 899px) { .cw { justify-self: stretch; max-width: none; } }
</style>
