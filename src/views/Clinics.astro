---
import Base from '../layouts/Base.astro';
import Station from '../components/Station.astro';
import Elbow from '../components/Elbow.astro';
import PhoneMock from '../components/PhoneMock.astro';
import ContactForm from '../components/ContactForm.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Arrow from '../components/Arrow.astro';
import ChatWindow from '../components/ChatWindow.astro';
import { initials } from '../lib/minisite';
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.clinics;
const schema = [{ '@type': 'Service', name: c.hero.eyebrow, description: c.description, serviceType: 'AI assistant', audience: { '@type': 'Audience', audienceType: 'Aesthetic clinics' } }];
---
<Base lang={lang} page="clinics" title={c.title} description={c.description} schema={schema}>
  <section class="lhero wrap" aria-labelledby="cl-title">
    <div class="lhero-text">
      <p class="tag"><b>04</b><span aria-hidden="true">/</span>{c.hero.eyebrow}</p>
      <h1 id="cl-title">{c.hero.title}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="lhero-cta">
        <a class="btn btn-hero" href="#pedido">{c.hero.cta}<Arrow /></a>
      </div>
      <p class="note-dot">{c.hero.note}</p>
    </div>

    <ChatWindow title={c.chat.assistant} subtitle={c.chat.sub} example={d.ui.example} caption={c.chat.caption} inputPh={c.chat.inputPh}>
      <li class="dm is-user"><span class="sr-only">{c.chat.owner}: </span><span class="dm-t">{c.chat.q1}</span></li>
      <li class="dm is-ai dm-rich">
        <span class="sr-only">{c.chat.assistant}: </span>
        <div class="dm-t">
          <p>{c.chat.a1}</p>
          <ul class="cl-list">
            {c.chat.list.map(([n, x]) => (
              <li><span class="cl-av" aria-hidden="true">{initials(n)}</span><span class="cl-txt"><b>{n}</b><small>{x}</small></span></li>
            ))}
          </ul>
        </div>
      </li>
      <li class="dm is-ai dm-rich">
        <span class="sr-only">{c.chat.assistant}: </span>
        <div class="dm-t cl-draft">
          <p class="tag">{c.chat.draftLabel}</p>
          <p>{c.chat.draft}</p>
          <div class="cl-actions" aria-hidden="true"><span>{c.chat.edit}</span><span class="is-primary">{c.chat.send}</span></div>
        </div>
      </li>
      <li class="dm is-user"><span class="sr-only">{c.chat.owner}: </span><span class="dm-t">{c.chat.q2}</span></li>
    </ChatWindow>
  </section>

  <div class="line wrap">
    <Station side="left" code="04.1" name={c.does.name} labelledby="cl-does" start>
      <div class="station-head"><h2 id="cl-does">{c.does.title}</h2></div>
      <ol class="items items-3">
        {c.does.items.map(([h, p], i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="04.2" name={c.returns.name} labelledby="cl-ret">
      <div class="station-head">
        <h2 id="cl-ret">{c.returns.title}</h2>
        <p class="lead">{c.returns.text}</p>
      </div>
      <figure class="returns panel">
        <div class="returns-head"><span class="tag">{c.returns.caption}</span><span class="tag-example">{d.ui.example}</span></div>
        <table>
          <caption class="sr-only">{c.returns.caption} ({d.ui.example})</caption>
          <thead><tr>{c.returns.cols.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {c.returns.rows.map((r) => (
              <tr>
                <th scope="row" data-label={c.returns.cols[0]}>{r[0]}</th>
                <td data-label={c.returns.cols[1]}>{r[1]}</td>
                <td data-label={c.returns.cols[2]}>{r[2]}</td>
                <td data-label={c.returns.cols[3]}>{r[3]}</td>
                <td data-label={c.returns.cols[4]}><span class:list={['badge', r[4] === 'ready' ? 'is-ready' : 'is-next']}>{r[4] === 'ready' ? c.returns.ready : c.returns.next}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </figure>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="04.3" name={c.morning.name} labelledby="cl-morn">
      <div class="st-grid">
        <div class="st-text">
          <h2 id="cl-morn">{c.morning.title}</h2>
          <p class="lead">{c.morning.text}</p>
        </div>
        <figure class="morning">
          <PhoneMock>
            <div class="pm">
              <div class="pm-status" aria-hidden="true"><span>08:00</span><span class="tag-example">{d.ui.example}</span></div>
              <div class="pm-head"><span class="pm-av" aria-hidden="true">{lang === 'en' ? 'AI' : 'IA'}</span><span><b>{c.morning.sender}</b><small>{c.morning.senderSub}</small></span></div>
              <div class="pm-msg">
                <p class="sr-only">{c.morning.srIntro}</p>
                <p class="pm-greet">{c.morning.greet}</p>
                <dl>{c.morning.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
                <span class="pm-time" aria-hidden="true">08:00</span>
              </div>
            </div>
          </PhoneMock>
        </figure>
      </div>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="04.4" name={c.how.name} labelledby="cl-how">
      <div class="station-head"><h2 id="cl-how">{c.how.title}</h2></div>
      <ol class="timeline">
        {c.how.steps.map(([h, p], i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
      <p class="timeline-done note-dot">{c.how.done}</p>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="04.5" name={c.pilot.name} labelledby="cl-pilot">
      <div class="st-grid">
        <div class="st-text">
          <h2 id="cl-pilot">{c.pilot.title}</h2>
          <p class="lead">{c.pilot.text}</p>
          <p><a class="btn btn-hero" href="#pedido">{c.hero.cta}<Arrow /></a></p>
        </div>
        <ul class="pilot panel">
          {c.pilot.items.map(([h, p]) => <li><h3>{h}</h3><p class="muted">{p}</p></li>)}
        </ul>
      </div>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="04.6" name={c.rgpd.name} labelledby="cl-rgpd">
      <div class="station-head"><h2 id="cl-rgpd">{c.rgpd.title}</h2></div>
      <ul class="items">
        {c.rgpd.items.map(([h, p], i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ul>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="04.7" name={c.form.name} labelledby="cl-form" end>
      <div class="form-split">
        <div class="st-text">
          <h2 id="cl-form">{c.form.title}</h2>
          <p class="lead">{c.form.text}</p>
          <CopyEmail lang={lang} label={d.form.emailAlt} />
        </div>
        <ContactForm lang={lang} page="clinics" service="clinics" />
      </div>
    </Station>
  </div>
</Base>

<style>
  .cl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .cl-list li { display: flex; align-items: center; gap: 10px; padding: 7px 8px; border-radius: 10px; background: var(--surface-2); }
  .cl-av { width: 30px; height: 30px; border-radius: 50%; flex: none; display: grid; place-items: center; font-family: var(--f-mono); font-size: 0.7rem; font-weight: 500; background: color-mix(in srgb, var(--hero) 35%, var(--surface)); color: var(--ink); }
  .cl-txt { display: grid; line-height: 1.3; min-width: 0; }
  .cl-txt b { font-weight: 500; font-size: 0.92rem; }
  .cl-txt small { color: var(--muted); font-size: 0.82rem; }
  .cl-draft { padding-left: 12px; border-left: 3px solid var(--hero); }
  .cl-actions { display: flex; gap: 8px; justify-content: flex-end; }
  .cl-actions span { padding: 6px 12px; border-radius: 8px; font-size: 0.82rem; font-weight: 500; border: 1px solid var(--line-strong); }
  .cl-actions .is-primary { background: var(--hero); color: var(--on-hero); border-color: var(--hero); }

  .returns { padding: 18px; overflow: hidden; }
  .returns-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 12px; }
  .returns table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .returns th, .returns td { text-align: left; padding: 12px 10px; border-top: 1px solid var(--line); vertical-align: middle; }
  .returns thead th { font-family: var(--f-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); border-top: 0; }
  .returns tbody th { font-weight: 500; }
  .badge { display: inline-block; padding: 4px 9px; border-radius: 6px; font-size: 0.8rem; font-weight: 500; white-space: nowrap; }
  .badge.is-ready { background: var(--hero); color: var(--on-hero); }
  .badge.is-next { border: 1px dashed var(--line-strong); color: var(--muted); }
  @media (max-width: 720px) {
    .returns thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .returns tr { display: grid; grid-template-columns: minmax(0, 1fr); padding: 12px 0; border-top: 1px solid var(--line); }
    .returns th, .returns td { display: grid; grid-template-columns: 120px 1fr; gap: 10px; border: 0; padding: 4px 0; }
    .returns th::before, .returns td::before { content: attr(data-label); font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding-top: 3px; }
    .returns td .badge { justify-self: start; }
  }

  .morning { justify-self: end; }
  @media (max-width: 899px) { .morning { justify-self: center; } }
  .pm { height: 100%; background: #eef1f4; color: #10182b; padding: 46px 12px 14px; display: flex; flex-direction: column; gap: 12px; font-size: 12.5px; }
  .pm-status { display: flex; justify-content: space-between; align-items: center; font-family: var(--f-mono); font-size: 11px; position: absolute; top: 15px; left: 28px; right: 24px; }
  .pm-status .tag-example { background: #fff; color: #4a556b; font-size: 9px; padding: 1px 5px; }
  .pm-head { display: flex; gap: 10px; align-items: center; padding: 8px 6px 10px; border-bottom: 1px solid #d5dbe3; }
  .pm-head span:last-child { display: grid; line-height: 1.25; }
  .pm-head small { color: #4a556b; font-size: 11px; }
  .pm-av { width: 32px; height: 32px; border-radius: 10px; background: #ffc83d; color: #10182b; display: grid; place-items: center; font-family: var(--f-mono); font-weight: 500; font-size: 11px; }
  .pm-msg { position: relative; background: #fff; border-radius: 14px; border-top-left-radius: 4px; padding: 12px 12px 22px; display: grid; gap: 8px; box-shadow: 0 1px 0 #d5dbe3; }
  .pm-greet { font-weight: 500; }
  .pm-msg dl { margin: 0; display: grid; gap: 7px; }
  .pm-msg dt { font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #4a556b; }
  .pm-msg dd { margin: 0; }
  .pm-time { position: absolute; right: 10px; bottom: 6px; font-family: var(--f-mono); font-size: 9.5px; color: #4a556b; }

  .pilot { list-style: none; margin: 0; padding: 6px 22px; display: grid; }
  .pilot li { padding: 16px 0; border-top: 1px solid var(--line); display: grid; gap: 4px; }
  .pilot li:first-child { border-top: 0; }
</style>
