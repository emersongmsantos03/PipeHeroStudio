---
import Base from '../layouts/Base.astro';
import Station from '../components/Station.astro';
import Elbow from '../components/Elbow.astro';
import ContactForm from '../components/ContactForm.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Arrow from '../components/Arrow.astro';
import OfferDemo from '../components/OfferDemo.astro';
import { t } from '../i18n';
import { priceFrom, type Lang } from '../i18n/routes';
import { config } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.crm;
const crmPrice = priceFrom(lang, config.crmFrom, d.ui.onRequest, d.ui.from);
const SX = [100, 300, 500];
const TX = [75, 225, 375, 525];
const cards = c.funnel.cards as [string, number, number][];
const schema = [{ '@type': 'Service', name: c.price.label, description: c.description, serviceType: 'CRM automation' }];
---
<Base lang={lang} page="crm" title={c.title} description={c.description} schema={schema}>
  <section class="lhero lhero-solo wrap" aria-labelledby="crm-title">
    <div class="lhero-text">
      <p class="tag"><b>03</b><span aria-hidden="true">/</span>CRM</p>
      <h1 id="crm-title">{c.hero.title}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="lhero-cta"><a class="btn btn-hero" href="#pedido">{c.hero.cta}<Arrow /></a>
        <a class="link link-arrow" href="#demo-crm">{({ en: 'Try the demo', pt: 'Testar demonstração', es: 'Probar la demostración' })[lang]}<Arrow /></a>
      </div>
    </div>

  </section>

  <OfferDemo lang={lang} offer="crm" />

  <div class="line wrap">
    <Station side="left" code="03.1" name={c.does.name} labelledby="crm-does" start>
      <div class="station-head"><h2 id="crm-does">{c.does.title}</h2></div>
      <div class="crm-flow">
      <figure class="funnel panel">
        <div class="fn-head"><span class="tag">CRM</span><span class="tag-example">{d.ui.example}</span></div>
        <ul class="fn-sources">{c.funnel.sources.map((s) => <li>{s}</li>)}</ul>
        <svg class="fn-pipes" viewBox="0 0 600 160" aria-hidden="true" focusable="false">
          <path class="fn-track" d="M100 0V80M300 0V80M500 0V80M75 80H525M75 80V160M225 80V160M375 80V160M525 80V160" />
          {cards.map(([, s, st], i) => (
            <g class="fn-cap" style={`--sx:${SX[s]}px;--tx:${TX[st]}px;--i:${i}`}>
              <rect x="-5" y="-9" width="10" height="18" rx="4" />
            </g>
          ))}
        </svg>
        <div class="fn-stages">
          {c.funnel.stages.map((stage, j) => (
            <div class="fn-col">
              <p class="fn-title">{stage}</p>
              {cards.map(([n, s, st], i) => st === j && (
                <p class="fn-card" style={`--i:${i}`}><b>{n}</b><span>{c.funnel.sources[s]}</span></p>
              ))}
            </div>
          ))}
        </div>
        <figcaption class="fn-cap-text muted">{c.funnel.caption}</figcaption>
      </figure>
        <ol class="items crm-items">
          {c.does.items.map(([h, p], i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>)}
        </ol>
      </div>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="03.2" name={c.fits.name} labelledby="crm-fits">
      <div class="st-grid">
        <div class="st-text">
          <h2 id="crm-fits">{c.fits.title}</h2>
          <p class="lead">{c.fits.text}</p>
        </div>
        <div class="tools">
          <ul>{c.fits.tools.map((tool) => <li>{tool}</li>)}</ul>
          <p class="muted tools-note">{c.fits.toolsNote}</p>
        </div>
      </div>
    </Station>
    <Elbow from="right" />

    <Station side="left" code="03.3" name={c.price.name} labelledby="crm-price">
      <div class="st-grid">
        <div class="st-text">
          <h2 id="crm-price">{c.price.title}</h2>
          <p class="lead">{c.price.note}</p>
        </div>
        <div class="price-card panel">
          <p class="tag">{c.price.label}</p>
          <p class:list={['price-amount', !config.crmFrom && 'is-text']}>{crmPrice}</p>
        </div>
      </div>
    </Station>
    <Elbow from="left" />

    <Station side="right" code="03.4" name={c.form.name} labelledby="crm-form" end>
      <div class="form-split">
        <div class="st-text">
          <h2 id="crm-form">{c.form.title}</h2>
          <p class="lead">{c.form.text}</p>
          <CopyEmail lang={lang} label={d.form.emailAlt} />
        </div>
        <ContactForm lang={lang} page="crm" service="crm" />
      </div>
    </Station>
  </div>
</Base>

<style>
  .crm-flow { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .crm-items { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 899px) { .crm-flow { grid-template-columns: minmax(0, 1fr); } }
  .funnel { padding: 18px; display: grid; gap: 10px; width: 100%; view-timeline: --funnel block; }
  .fn-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px dashed var(--line-strong); }
  .fn-sources { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fn-sources li { justify-self: center; font-family: var(--f-mono); font-size: 0.76rem; letter-spacing: 0.04em; padding: 6px 10px; border-radius: 8px; border: 1.5px solid var(--ink); background: var(--surface); }
  .fn-pipes { width: 100%; height: auto; overflow: visible; margin-block: -2px; }
  .fn-track { fill: none; stroke: var(--line-strong); stroke-width: 3; stroke-linecap: round; }
  .fn-cap rect { fill: var(--hero); stroke: var(--ink); stroke-width: 1.5; }
  .fn-cap { opacity: 0; }
  .fn-stages { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
  .fn-col { display: grid; gap: 6px; align-content: start; padding: 8px 4px; margin-inline: 3px; border-radius: 8px; background: var(--surface-2); min-height: 150px; }
  .fn-title { font-family: var(--f-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); text-align: center; overflow-wrap: anywhere; }
  .fn-card { display: grid; gap: 1px; padding: 7px 8px; border-radius: 7px; background: var(--surface); border: 1px solid var(--line); font-size: 0.82rem; }
  .fn-card b { font-weight: 500; overflow-wrap: anywhere; }
  .fn-card span { font-family: var(--f-mono); font-size: 0.66rem; color: var(--muted); overflow-wrap: anywhere; }
  .fn-cap-text { font-size: 0.85rem; }
  @media (max-width: 560px) {
    .funnel { padding: 12px; }
    .fn-sources li { font-size: 0.62rem; padding: 4px 6px; letter-spacing: 0; }
    .fn-col { margin-inline: 2px; padding: 6px 3px; min-height: 120px; }
    .fn-title { font-size: 0.54rem; letter-spacing: 0; overflow-wrap: normal; word-break: keep-all; }
    .fn-card { padding: 5px 5px; font-size: 0.7rem; }
    .fn-card b { overflow-wrap: normal; }
    .fn-card span { display: none; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fn-cap {
        animation: fn-flow linear both;
        animation-timeline: --funnel;
        animation-range: cover calc(8% + var(--i) * 3.5%) cover calc(34% + var(--i) * 3.5%);
      }
      .fn-card {
        animation: fn-card linear both;
        animation-timeline: --funnel;
        animation-range: cover calc(32% + var(--i) * 3.5%) cover calc(36% + var(--i) * 3.5%);
      }
    }
  }
  @keyframes fn-flow {
    0% { opacity: 0; transform: translate(var(--sx), -12px); }
    8% { opacity: 1; }
    35% { transform: translate(var(--sx), 80px); }
    65% { transform: translate(var(--tx), 80px); }
    92% { opacity: 1; }
    100% { opacity: 0; transform: translate(var(--tx), 168px); }
  }
  @keyframes fn-card { from { transform: scale(0.001); } }
  .fn-card { transform-origin: 50% 0; }

  .tools ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .tools li { padding: 10px 16px; border-radius: var(--radius); border: 1px solid var(--line-strong); background: var(--surface); font-weight: 500; }
  .tools-note { margin-top: 14px; font-size: 0.9rem; }
</style>
