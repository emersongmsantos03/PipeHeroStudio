{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pipeherostudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",

  // O site estático (Astro) sai de dist/. O Worker só corre em /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/r/*"]
  },

  // Envio do formulário por e-mail (Cloudflare Email Service).
  // Só permite enviar a partir deste remetente, que tem de pertencer ao domínio configurado no Email Sending.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["site@pipeherostudio.digital"]
    }
  ],

  // Leads do chat (guardados sempre, mesmo que o e-mail falhe). Ver no painel: Storage & Databases → KV → LEADS.
  "kv_namespaces": [{ "binding": "LEADS", "id": "a389ac5cabd240fca436420cb9d66dfc" }],

  // CRM (leads, financeiro, métricas). Partilhada com o painel admin.pipeherostudio.digital (admin/wrangler.jsonc).
  // Migrações: npx wrangler d1 migrations apply pipehero-crm --remote
  "d1_databases": [
    { "binding": "DB", "database_name": "pipehero-crm", "database_id": "9be8dee8-5f39-4557-8a45-0a100e514ec1", "migrations_dir": "migrations" }
  ],

  // Limite do chat por visitante (IP): 15 mensagens por minuto.
  "ratelimits": [
    { "name": "CHAT_RL", "namespace_id": "1001", "simple": { "limit": 15, "period": 60 } },
    { "name": "BOOK_RL", "namespace_id": "1005", "simple": { "limit": 6, "period": 60 } }
  ],

  // OPENAI_API_KEY é um segredo (npx wrangler secret put OPENAI_API_KEY). Nunca no código.
  // CONTACT_TO e OPENAI_MODEL (opcionais) podem ser definidos no painel: Settings → Variables. Não são apagados nos deploys.
  "keep_vars": true,

  "observability": { "enabled": true },

  // Domínio próprio (a zona pipeherostudio.digital tem de estar ativa na Cloudflare).
  "routes": [{ "pattern": "pipeherostudio.digital", "custom_domain": true }]
}
